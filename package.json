{
	"name": "firefox-startpage",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"ext:dev": "vite build && concurrently -k -n vite,web-ext \"vite build --watch\" \"web-ext run\"",
		"ext:lint": "vite build && web-ext lint",
		"ext:build": "vite build && web-ext build --overwrite-dest",
		"ext:sign": "vite build && node scripts/sign.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/webextension-polyfill": "^0.12.6",
		"concurrently": "^10.0.6",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"web-ext": "^10.7.0"
	},
	"dependencies": {
		"webextension-polyfill": "^0.12.0"
	}
}
